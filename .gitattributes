# Normalize text files to LF in the repository (cross-platform / forks).
* text=auto eol=lf

*.rs   text eol=lf
*.md   text eol=lf
*.toml text eol=lf
*.php  text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.lock text eol=lf
*.txt  text eol=lf

LICENSE text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
.editorconfig text eol=lf

*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.pdf  binary
*.so   binary
*.dll  binary
*.exe  binary
